{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": ".NET appsettings",
  "type": "object",
  "properties": {
    "Logging": {
      "type": "object",
      "properties": {
        "LogLevel": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "ConnectionStrings": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "JwtSettings": {
      "type": "object",
      "properties": {
        "SecretKey": {
          "type": "string"
        },
        "Issuer": {
          "type": "string"
        },
        "Audience": {
          "type": "string"
        },
        "ExpiryInMinutes": {
          "type": ["string", "number"]
        }
      },
      "additionalProperties": true
    },
    "AllowedHosts": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
